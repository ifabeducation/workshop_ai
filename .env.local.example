# Copia questo file in .env.local e compila i valori prima di avviare l'app.

# OpenAI — alimenta gli agenti AI integrati nelle sottosezioni
OPENAI_API_KEY=sk-...

# Password condivisa per l'accesso del facilitatore (una sola per l'evento)
FACILITATOR_PASSWORD=cambia-questa-password

# Upstash Redis (o Vercel KV, che espone le stesse env var) — store condiviso
# di stato sessione/partecipanti/submission per la durata del workshop.
# Crea un database gratuito su https://console.upstash.com
KV_REST_API_URL=https://xxxxx.upstash.io
KV_REST_API_TOKEN=xxxxx
